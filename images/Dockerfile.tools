# Dockerfile.tools — Extends the OpenClaw base image with pre-baked CLI tools.
#
# Usage (two-step build):
#   az acr build --image openclaw:base --file openclaw-repo/Dockerfile openclaw-repo
#   az acr build --image openclaw:latest --build-arg BASE_IMAGE=$ACR/openclaw:base --file images/Dockerfile.tools images/
#
# Tools installed:
#   - Go 1.24.1        → /usr/local/go
#   - GitHub CLI 2.72.0 → /usr/local/bin/gh
#   - Gemini CLI       → /usr/local/bin/gemini  (npm global)
#   - GoG CLI          → /usr/local/bin/gog     (built from source)
#   - Bun               → /usr/local/bin/bun
#   - Tesseract OCR    → /usr/bin/tesseract (with eng,fra,deu,spa,ita,por,rus,chi-sim,jpn language packs)
#   - Python 3.13.x    → /usr/local/bin/python3
#   - redis-py         → Python redis client    (installed via pip)
#   - pytesseract      → Python Tesseract bindings (installed via pip)
#   - PyMuPDF          → Python PDF processing  (installed via pip)
#   - sqlite-vec       → SQLite vector extension (native .so for QMD)
#   - Freqtrade        → /usr/local/bin/freqtrade (crypto trading bot)
#   - freqtrade-strategies → /opt/freqtrade-strategies (community strategies)
#   - PyTorch (CPU)    → torch inference runtime (CPU-only, no CUDA)
#   - einops           → tensor operations      (installed via pip)
#   - safetensors      → fast model serialization(installed via pip)
#   - huggingface_hub  → HF model downloads     (installed via pip)
#   - yfinance         → Yahoo Finance data      (installed via pip)
#   - openbb           → OpenBB financial data platform (installed via pip)
#   - scipy            → scientific computing     (installed via pip)
#   - statsmodels      → statistical modeling     (installed via pip)
#   - langgraph + langchain-* → TradingAgents framework deps (installed via pip)
#   - stockstats, backtrader, parsel → TradingAgents framework deps (installed via pip)
#
# Performance: installs are grouped into stable layers so iterative rebuilds
# can reuse cache when only later steps change.

ARG BASE_IMAGE=openclaw-source:base
ARG PYTHON_VERSION=3.13
FROM python:${PYTHON_VERSION}-slim-bookworm AS python-runtime

FROM ${BASE_IMAGE}
ARG PYTHON_VERSION

USER root

# ── Python runtime (targeted copy — avoids overwriting node/npm binaries) ────
COPY --from=python-runtime /usr/local/bin/python* /usr/local/bin/
COPY --from=python-runtime /usr/local/bin/pip* /usr/local/bin/
COPY --from=python-runtime /usr/local/lib/python${PYTHON_VERSION} /usr/local/lib/python${PYTHON_VERSION}
COPY --from=python-runtime /usr/local/lib/libpython* /usr/local/lib/

# ── System packages (Tesseract OCR + language data) ────────────────────────
RUN set -eux \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       tesseract-ocr \
       tesseract-ocr-eng \
       tesseract-ocr-fra \
       tesseract-ocr-deu \
       tesseract-ocr-spa \
       tesseract-ocr-ita \
       tesseract-ocr-por \
       tesseract-ocr-rus \
       tesseract-ocr-chi-sim \
       tesseract-ocr-jpn \
       libtesseract5 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── All CLI tools in a single layer ─────────────────────────────────────────
ENV GOROOT=/usr/local/go \
    PATH="/usr/local/go/bin:${PATH}"

RUN set -eux \
     && ldconfig \
     # Go 1.24.1
     && curl -fsSL https://go.dev/dl/go1.24.1.linux-amd64.tar.gz \
         | tar -xz -C /usr/local \
     # GitHub CLI v2.72.0 — strip debug symbols to halve binary size
     && curl -fsSL https://github.com/cli/cli/releases/download/v2.72.0/gh_2.72.0_linux_amd64.tar.gz \
         | tar -xz --strip-components=2 -C /usr/local/bin gh_2.72.0_linux_amd64/bin/gh \
     && strip /usr/local/bin/gh 2>/dev/null || true \
     # Gemini CLI + sqlite-vec (npm) — sqlite-vec provides the native .so for QMD vector ops
     && npm install -g @google/gemini-cli@latest sqlite-vec \
     # GoG CLI — compile with stripped symbols (-s -w) to reduce binary ~50%
     && git clone --depth 1 https://github.com/steipete/gogcli.git /tmp/gogcli \
     && cd /tmp/gogcli && CGO_ENABLED=0 go build -ldflags="-s -w" -trimpath -o /usr/local/bin/gog ./cmd/gog \
     && cd / && rm -rf /tmp/gogcli \
     # Bun — required by qmd (session memory / vector store)
     && npm install -g bun

RUN set -eux \
     # Python validation
     && python3 -V 2>&1 | grep -E "^Python ${PYTHON_VERSION}(\\.|$)" \
     # Core packages (scipy/statsmodels first — they have strict numpy requirements)
     && python3 -m pip install --no-cache-dir redis freqtrade pytesseract markitdown pymupdf \
         scipy==1.14.1 statsmodels==0.14.6 einops safetensors \
         huggingface_hub yfinance openbb \
         langgraph langgraph-checkpoint-sqlite langchain-core langchain-groq \
         langchain-openai langchain-anthropic langchain-google-genai \
         langchain-experimental stockstats backtrader parsel \
     # PyTorch last (installs after scipy/statsmodels so it adapts to the numpy environment)
     && ( python3 -m pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
            || python3 -m pip install --no-cache-dir torch ) \
     && python3 -c "import torch; print(f'torch {torch.__version__} on Python ${PYTHON_VERSION} OK'); import torch.utils.data" \
     # OpenBB writes generated extension code into its package dir on first import;
     # make the directory world-writable so non-root container users can do this.
     && chmod -R a+w /usr/local/lib/python${PYTHON_VERSION}/site-packages/openbb/ \
     # Verify torch libraries are accessible (critical for ML inference)
     && python3 -c "import torch; print(f'PyTorch libraries: {torch.__file__}')" \
     && ldconfig -p | grep -E "(libtorch|libc10)" | head -5

RUN set -eux \
     # Freqtrade strategies — community strategy repository
     && git clone --depth 1 https://github.com/freqtrade/freqtrade-strategies.git /opt/freqtrade-strategies \
     # Freqtrade config — dry-run paper trading on Binance (BTC/USDT, ETH/USDT)
     && mkdir -p /opt/freqtrade/user_data/strategies \
     && cp /opt/freqtrade-strategies/user_data/strategies/berlinguyinca/*.py /opt/freqtrade/user_data/strategies/ 2>/dev/null || true \
     && printf '{\n  "max_open_trades": 3,\n  "stake_currency": "USDT",\n  "stake_amount": "unlimited",\n  "tradable_balance_ratio": 0.99,\n  "fiat_display_currency": "USD",\n  "dry_run": true,\n  "dry_run_wallet": 1000,\n  "trading_mode": "spot",\n  "cancel_open_orders_on_exit": false,\n  "unfilledtimeout": { "entry": 10, "exit": 10, "unit": "minutes" },\n  "entry_pricing": { "price_side": "same", "use_order_book": true, "order_book_top": 1 },\n  "exit_pricing": { "price_side": "same", "use_order_book": true, "order_book_top": 1 },\n  "exchange": {\n    "name": "binance",\n    "key": "",\n    "secret": "",\n    "pair_whitelist": ["BTC/USDT", "ETH/USDT", "SOL/USDT", "XRP/USDT"],\n    "pair_blacklist": []\n  },\n  "pairlists": [{ "method": "StaticPairList" }],\n  "bot_name": "freqtrade-openclaw",\n  "initial_state": "running",\n  "internals": { "process_throttle_secs": 5 },\n  "strategy": "SampleStrategy",\n  "strategy_path": "/opt/freqtrade/user_data/strategies"\n}\n' > /opt/freqtrade/config.json \
     # Comprehensive cleanup: Go caches, npm caches, pip caches, Python bytecache, test dirs
     && rm -rf /tmp/* /root/go /root/.cache/go-build /root/.cache/go /root/.cache/pip /root/.npm \
     && rm -rf /root/.bun/install /root/.bun/cache \
     && find /usr/local/lib/python${PYTHON_VERSION} -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true \
     && find /usr/local/lib/python${PYTHON_VERSION}/site-packages -maxdepth 2 -type d -name "tests" -exec rm -rf {} + 2>/dev/null || true \
     && find /usr/local/lib/python${PYTHON_VERSION}/site-packages -maxdepth 2 -type d -name "test" -exec rm -rf {} + 2>/dev/null || true \
     && find /usr/local/lib/node_modules -name "*.d.ts" -o -name "*.map" | xargs rm -f 2>/dev/null || true \
     && npm cache clean --force

ENV GOPATH=/home/node/.openclaw/gopath
ENV PATH="/home/node/.openclaw/gopath/bin:${PATH}"

USER node
