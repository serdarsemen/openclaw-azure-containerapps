# Dockerfile.tools — Extends the OpenClaw base image with pre-baked CLI tools.
#
# Usage (two-step build):
#   az acr build --image openclaw:base --file openclaw-repo/Dockerfile openclaw-repo
#   az acr build --image openclaw:latest --build-arg BASE_IMAGE=$ACR/openclaw:base --file images/Dockerfile.tools images/
#
# Tools installed:
#   - Go 1.24.1        → /usr/local/go
#   - GitHub CLI 2.72.0 → /usr/local/bin/gh
#   - Gemini CLI       → /usr/local/bin/gemini  (npm global)
#   - GoG CLI          → /usr/local/bin/gog     (built from source)
#   - Python 3.14.3    → /usr/local/bin/python3
#   - redis-py         → Python redis client    (installed via pip)
#   - sqlite-vec       → SQLite vector extension (native .so for QMD)
#   - Freqtrade        → /usr/local/bin/freqtrade (crypto trading bot)
#   - freqtrade-strategies → /opt/freqtrade-strategies (community strategies)
#
# Performance: all tool installs are merged into a single RUN to minimise
# intermediate layer commits on ACR Tasks (classic builder, no BuildKit).

ARG BASE_IMAGE
ARG PYTHON_VERSION=3.14
FROM python:${PYTHON_VERSION}-slim-bookworm AS python-runtime

FROM ${BASE_IMAGE}
ARG PYTHON_VERSION

USER root

# ── Python runtime (targeted copy — avoids overwriting node/npm binaries) ────
COPY --from=python-runtime /usr/local/bin/python* /usr/local/bin/
COPY --from=python-runtime /usr/local/bin/pip* /usr/local/bin/
COPY --from=python-runtime /usr/local/lib/python${PYTHON_VERSION} /usr/local/lib/python${PYTHON_VERSION}
COPY --from=python-runtime /usr/local/lib/libpython* /usr/local/lib/

# ── All CLI tools in a single layer ─────────────────────────────────────────
ENV GOROOT=/usr/local/go \
    PATH="/usr/local/go/bin:${PATH}"

RUN set -eux \
    && ldconfig \
    # Go 1.24.1
    && curl -fsSL https://go.dev/dl/go1.24.1.linux-amd64.tar.gz \
       | tar -xz -C /usr/local \
    # GitHub CLI v2.72.0 — strip debug symbols to halve binary size
    && curl -fsSL https://github.com/cli/cli/releases/download/v2.72.0/gh_2.72.0_linux_amd64.tar.gz \
       | tar -xz --strip-components=2 -C /usr/local/bin gh_2.72.0_linux_amd64/bin/gh \
    && strip /usr/local/bin/gh 2>/dev/null || true \
    # Gemini CLI + sqlite-vec (npm) — sqlite-vec provides the native .so for QMD vector ops
    && npm install -g @google/gemini-cli@latest sqlite-vec \
    # GoG CLI — compile with stripped symbols (-s -w) to reduce binary ~50%
    && git clone --depth 1 https://github.com/steipete/gogcli.git /tmp/gogcli \
    && cd /tmp/gogcli && CGO_ENABLED=0 go build -ldflags="-s -w" -trimpath -o /usr/local/bin/gog ./cmd/gog \
    # Python validation + redis-py
    && python3 -V 2>&1 | grep -E "^Python ${PYTHON_VERSION}(\\.|$)" \
    && python3 -m pip install --no-cache-dir redis freqtrade \
    # Freqtrade strategies — community strategy repository
    && git clone --depth 1 https://github.com/freqtrade/freqtrade-strategies.git /opt/freqtrade-strategies \
    # Comprehensive cleanup: Go caches, npm caches, pip caches, Python bytecache, test dirs
    && cd / && rm -rf /tmp/* /root/go /root/.cache/go-build /root/.cache/go /root/.cache/pip /root/.npm \
    && find /usr/local/lib/python${PYTHON_VERSION} -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true \
    && find /usr/local/lib/python${PYTHON_VERSION} -type d -name "test*" -prune -exec rm -rf {} + 2>/dev/null || true \
    && find /usr/local/lib/node_modules -name "*.d.ts" -o -name "*.map" | xargs rm -f 2>/dev/null || true \
    && npm cache clean --force

ENV GOPATH=/home/node/.openclaw/gopath \
    PATH="/home/node/.openclaw/gopath/bin:${PATH}"

USER node
