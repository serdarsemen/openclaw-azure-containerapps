# Dockerfile.npmtools — Extends the OpenClaw npm base image with pre-baked CLI tools.
#
# Usage (two-step build):
#   az acr build --image openclaw:base --file $buildDir/Dockerfile $buildDir
#   az acr build --image openclaw:latest --build-arg BASE_IMAGE=$ACR/openclaw:base --file images/Dockerfile.npmtools images/
#
# Tools installed (same as Dockerfile.tools plus Bun/QMD):
#   - Go 1.24.1         → /usr/local/go
#   - GitHub CLI 2.72.0  → /usr/local/bin/gh
#   - Gemini CLI         → /usr/local/bin/gemini  (npm global)
#   - GoG CLI            → /usr/local/bin/gog     (built from source)
#   - Python 3.14.3     → /usr/local/bin/python3
#   - redis-py           → Python redis client    (installed via pip)
#   - Bun                → /usr/local/bin/bun
#   - QMD                → /usr/local/bin/qmd     (installed via bun)
#
# Performance: all tool installs are merged into a single RUN to minimise
# intermediate layer commits on ACR Tasks (classic builder, no BuildKit).

ARG BASE_IMAGE
ARG PYTHON_VERSION=3.14.3
FROM python:${PYTHON_VERSION}-slim-bookworm AS python-runtime

FROM ${BASE_IMAGE}
ARG PYTHON_VERSION

USER root

# ── Python runtime (targeted copy — avoids overwriting node/npm binaries) ────
COPY --from=python-runtime /usr/local/bin/python* /usr/local/bin/
COPY --from=python-runtime /usr/local/bin/pip* /usr/local/bin/
COPY --from=python-runtime /usr/local/lib/python${PYTHON_VERSION} /usr/local/lib/python${PYTHON_VERSION}
COPY --from=python-runtime /usr/local/lib/libpython* /usr/local/lib/

# ── All CLI tools in a single layer ─────────────────────────────────────────
ENV GOROOT=/usr/local/go \
    PATH="/usr/local/go/bin:${PATH}"

RUN set -eux \
    && ldconfig \
    # Go 1.24.1
    && curl -fsSL https://go.dev/dl/go1.24.1.linux-amd64.tar.gz \
       | tar -xz -C /usr/local \
    # GitHub CLI v2.72.0
    && curl -fsSL https://github.com/cli/cli/releases/download/v2.72.0/gh_2.72.0_linux_amd64.tar.gz \
       | tar -xz --strip-components=2 -C /usr/local/bin gh_2.72.0_linux_amd64/bin/gh \
    # Gemini CLI (npm)
    && npm install -g @google/gemini-cli@latest \
    # GoG CLI (built from source)
    && git clone --depth 1 https://github.com/steipete/gogcli.git /tmp/gogcli \
    && cd /tmp/gogcli && go build -o /usr/local/bin/gog ./cmd/gog \
    # Bun + QMD
    && BUN_INSTALL=/usr/local curl -fsSL https://bun.sh/install | bash \
    && BUN_INSTALL=/usr/local bun install -g https://github.com/tobi/qmd 2>/dev/null || true \
    # Python validation + redis-py
    && python3 -V 2>&1 | grep -E "^Python ${PYTHON_VERSION}$" \
    && python3 -m pip install --no-cache-dir redis \
    # Clean up build artifacts, Go module cache, npm cache
    && rm -rf /tmp/gogcli /root/go /root/.cache/go-build \
    && npm cache clean --force

ENV GOPATH=/home/openclaw/.openclaw/gopath \
    PATH="/home/openclaw/.openclaw/gopath/bin:${PATH}"

USER openclaw
